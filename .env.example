# Copy to .env. Keep Google credentials private and never commit .env.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLIENT_ORIGINS=http://localhost:8081
OPEN_FOOD_FACTS_DATABASE_URL=postgres://open_food_facts:open_food_facts@localhost:5433/open_food_facts

# Leave empty in development to reach the API on the computer that serves Metro.
EXPO_PUBLIC_API_URL=
# Docker Compose only: this computer's LAN IP, so a phone can reach Metro (ipconfig getifaddr en0).
EXPO_DEV_HOST=localhost
# Docker Compose only: Expo access token (expo.dev → Account settings → Access tokens). Keep it private.
EXPO_TOKEN=
EXPO_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false
