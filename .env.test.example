# Copy to /opt/eatable-test/.env on the VPS and replace all placeholders.
IMAGE_NAME=ghcr.io/tpodkowski/eatable-api
WEB_IMAGE_NAME=ghcr.io/tpodkowski/eatable-web
IMAGE_TAG=test
POSTGRES_DB=eatable_test
POSTGRES_USER=eatable_test
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
DATABASE_URL=postgres://eatable_test:replace-with-a-long-random-alphanumeric-password@db:5432/eatable_test
OPEN_FOOD_FACTS_POSTGRES_DB=open_food_facts_test
OPEN_FOOD_FACTS_POSTGRES_USER=open_food_facts_test
OPEN_FOOD_FACTS_POSTGRES_PASSWORD=replace-with-another-long-random-alphanumeric-password
OPEN_FOOD_FACTS_DATABASE_URL=postgres://open_food_facts_test:replace-with-another-long-random-alphanumeric-password@open-food-facts-db:5432/open_food_facts_test
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=https://srv58-20133.wykr.es
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLIENT_ORIGINS=https://srv58-30133.wykr.es
