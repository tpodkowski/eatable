{
  "expo": {
    "name": "Eatable",
    "slug": "eatable",
    "scheme": "eatable",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "static"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eatable.app"
    },
    "android": {
      "package": "com.eatable.app"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ]
  }
}
