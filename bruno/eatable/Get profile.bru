meta {
  name: Get profile
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/profile
  body: none
  auth: none
}

headers {
  Cookie: {{sessionCookie}}
}

docs {
  Fetch the signed-in user's profile. A new profile uses 2000 kcal, 100 g protein, 250 g carbohydrates, and 67 g fat by default.

  Example response:
  {
    "dailyCalorieLimit": 2000,
    "dailyProteinLimit": 100,
    "dailyCarbohydratesLimit": 250,
    "dailyFatLimit": 67
  }
}
