meta {
  name: List products
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/products?q={{productSearch}}
  body: none
  auth: none
}

headers {
  Cookie: {{sessionCookie}}
}

docs {
  List the signed-in user's products. When q is provided, search results combine the user's products and Open Food Facts products in one result list. Provider failures do not prevent user products from being returned.

  Example response:
  [
    {
      "id": "user:b7906b25-4d20-465c-bbca-f5a922c4edb9",
      "provider": "user",
      "providerProductId": "b7906b25-4d20-465c-bbca-f5a922c4edb9",
      "name": "Oat milk",
      "brand": "Oats Co",
      "barcode": "04006381333931",
      "nutritionBasis": "100ml",
      "calories": 46.5,
      "protein": 1.1,
      "carbohydrates": 6.7,
      "fat": 1.5,
      "imageUrl": null,
      "imageAttribution": null,
      "imageLicense": null,
      "license": "user-provided",
      "attribution": "User-provided"
    }
  ]

  Unauthenticated requests return 401.
}
