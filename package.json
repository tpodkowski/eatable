{
  "name": "eatable",
  "private": true,
  "packageManager": "npm@11.20.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:mobile": "npm run start --workspace=@eatable/mobile",
    "dev:api": "npm run dev --workspace=@eatable/api",
    "build": "turbo build",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "~6.0.3"
  }
}
